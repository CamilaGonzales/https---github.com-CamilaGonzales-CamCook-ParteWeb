@page
@model CamCook.Pages.Marketplace.IndexModel

@{
    ViewData["Title"] = "Marketplace";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="mb-0">Marketplace</h2>
            <small class="text-muted">
                @Model.Proveedores.Count proveedor@(Model.Proveedores.Count == 1 ? "" : "es") disponible@(Model.Proveedores.Count == 1 ? "" : "s")
            </small>
        </div>

        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-2">
            <i class="bi bi-shop me-1"></i> Compra directo al proveedor
        </span>
    </div>

    @if (Model.Proveedores == null || Model.Proveedores.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="mb-2">
                <i class="bi bi-emoji-frown fs-1 text-warning"></i>
            </div>
            <h5 class="mb-1">Aún no hay proveedores publicados</h5>
            <p class="text-muted mb-0">
                Cuando se registren proveedores aprobados, aparecerán aquí.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4 mt-1">
            @foreach (var prov in Model.Proveedores)
            {
                var img          = prov.ContainsKey("imagen") ? prov["imagen"]?.ToString() : "";
                var nombre       = prov.ContainsKey("nombre") ? prov["nombre"]?.ToString() ?? "Proveedor" : "Proveedor";
                var proveedorId  = prov.ContainsKey("proveedorId") ? prov["proveedorId"]?.ToString() ?? "" : "";
                var tipo         = prov.ContainsKey("tipoProveedor") ? prov["tipoProveedor"]?.ToString() ?? "" : "";
                var ciudad       = prov.ContainsKey("ciudad") ? prov["ciudad"]?.ToString() ?? "" : "";

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 marketplace-card">
                        @if (!string.IsNullOrWhiteSpace(img))
                        {
                            <div class="ratio ratio-4x3">
                                <img src="@img"
                                     alt="@nombre"
                                     class="card-img-top rounded-top object-fit-cover" />
                            </div>
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-1 text-truncate">@nombre</h5>

                            @if (!string.IsNullOrEmpty(tipo) || !string.IsNullOrEmpty(ciudad))
                            {
                                <p class="card-text small text-muted mb-2">
                                    @if (!string.IsNullOrEmpty(tipo))
                                    {
                                        <span class="me-1">
                                            <i class="bi bi-basket-fill text-warning"></i> @tipo
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(ciudad))
                                    {
                                        <span>
                                            · <i class="bi bi-geo-alt-fill text-danger"></i> @ciudad
                                        </span>
                                    }
                                </p>
                            }

                            <p class="card-text small text-muted mb-3">
                                Descubre ingredientes y productos ofrecidos directamente por este proveedor.
                            </p>

                            <a asp-page="/Marketplace/ProveedorDetalleModel"
                               asp-route-id="@proveedorId"
                               class="btn btn-warning w-100 text-white rounded-pill">
                                Ver productos
                                <i class="bi bi-arrow-right-short ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
