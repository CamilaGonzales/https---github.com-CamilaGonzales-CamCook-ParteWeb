@page
@model CamCook.Pages.Recipes.MyRecipesModel
@{
    ViewData["Title"] = "Mis Recetas";
}

<div class="camcook-page-bg">
    <div class="container py-4 camcook-main">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Mis Recetas</h2>

            <a class="btn btn-success" asp-page="/Recipes/Create">
                + Crear Receta
            </a>
        </div>

        <!-- FILTROS Y BUSCADOR -->
        <form method="get" class="mb-4">
            <div class="d-flex gap-2 mb-3">
                <a class="btn @(Model.Estado != "borrador" ? "btn-primary" : "btn-outline-primary")"
                   asp-page="/Recipes/MyRecipes"
                   asp-route-search="@Model.Search"
                   asp-route-estado="">
                    Todas
                </a>
                <a class="btn @(Model.Estado == "borrador" ? "btn-warning" : "btn-outline-warning")"
                   asp-page="/Recipes/MyRecipes"
                   asp-route-search="@Model.Search"
                   asp-route-estado="borrador">
                    📝 Borradores
                </a>
            </div>

            <div class="camcook-search-area">
                <div class="camcook-search-input-wrapper">
                    <i class="fa fa-search camcook-search-icon"></i>
                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control camcook-search-input"
                           placeholder="Buscar en mis recetas...">
                </div>
                <button class="btn camcook-search-btn">Buscar</button>
            </div>
        </form>

        <!-- GRID DE MIS RECETAS -->
        <div class="row g-4">
            @foreach (var r in Model.Recetas)
            {
                <div class="col-12 col-sm-6 col-md-3">
                    <article class="camcook-recipe-card h-100">

                        <!-- Imagen -->
                        <div class="camcook-recipe-img-wrapper">
                            @if (!string.IsNullOrWhiteSpace(r.ImagenUrl))
                            {
                                <a asp-page="/Recipes/Details"
                                   asp-route-id="@r.Id"
                                   class="d-block">
                                    <img src="@r.ImagenUrl"
                                         alt="@r.Titulo"
                                         class="camcook-recipe-img" />
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Recipes/Details"
                                   asp-route-id="@r.Id"
                                   class="camcook-recipe-img-placeholder d-flex align-items-center justify-content-center text-decoration-none">
                                    Sin imagen
                                </a>
                            }
                        </div>

                        <div class="p-3">
                            <!-- Título clickeable -->
                            <h5 class="fw-semibold mb-2">
                                <a asp-page="/Recipes/Details"
                                   asp-route-id="@r.Id"
                                   class="text-decoration-none text-dark">
                                    @r.Titulo
                                </a>
                            </h5>

                            <!-- Descripción -->
                            <p class="camcook-recipe-excerpt mb-3">
                                @r.Descripcion
                            </p>

                            <!-- METADATOS -->
                            <div class="d-flex flex-wrap gap-2 mb-3 camcook-recipe-meta">
                                @if (!string.IsNullOrWhiteSpace(r.TiempoPrep))
                                {
                                    <span class="camcook-chip-time">
                                        ⏱️ @r.TiempoPrep
                                    </span>
                                }

                                @if (r.Porciones != null && r.Porciones > 0)
                                {
                                    <span class="camcook-chip-time">
                                        🍽️ @r.Porciones porciones
                                    </span>
                                }

                                @if (r.Calorias != null)
                                {
                                    <span class="camcook-chip-time">
                                        🔥 @(r.Calorias ?? 0) kcal
                                    </span>
                                }

                                @if (r.Likes != null)
                                {
                                    <span class="camcook-chip-time">
                                        ❤️ @(r.Likes ?? 0)
                                    </span>
                                }

                                @if (r.Views != null)
                                {
                                    <span class="camcook-chip-time">
                                        👁 @(r.Views ?? 0)
                                    </span>
                                }
                            </div>

                            <!-- BOTONES (solo autor) -->
                            @if (User.Identity?.IsAuthenticated ?? false && r.EsAutor)
                            {
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-page="/Recipes/Update"
                                       asp-route-id="@r.Id">
                                        Editar
                                    </a>

                                    <form method="post"
                                          asp-page="/Recipes/Delete"
                                          asp-route-id="@r.Id"
                                          class="d-inline form-delete"
                                          data-recipetitle="@r.Titulo">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>

        <!-- PAGINACIÓN -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación mis recetas" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Recipes/MyRecipes" asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-page="@(Model.Page - 1)">Anterior</a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <li class="page-item active"><span class="page-link">@p</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-page="/Recipes/MyRecipes" asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-page="@p">@p</a></li>
                        }
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Recipes/MyRecipes" asp-route-search="@Model.Search" asp-route-estado="@Model.Estado" asp-route-page="@(Model.Page + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll('.form-delete').forEach(f => {
            f.addEventListener('submit', function (e) {
                e.preventDefault();

                const recipeTitle = f.dataset.recipetitle || 'esta receta';

                Swal.fire({
                    title: `¿Eliminar receta "${recipeTitle}"?`,
                    text: 'Esta acción no se puede deshacer.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then(result => {
                    if (result.isConfirmed) {
                        f.submit();
                    }
                });
            });
        });
    </script>
}
