@page
@model CamCook.Pages.Recipes.ListModel
@using System.Security.Claims
@functions {
    string? CurrentUid() =>
        User?.FindFirstValue(ClaimTypes.NameIdentifier)
        ?? User?.FindFirstValue("uid");
}
@{
    ViewData["Title"] = "Recetas publicadas";
    var currentUserUid = CurrentUid() ?? "";
}

<h2 class="mb-3">Recetas publicadas</h2>

@if (User?.Identity?.IsAuthenticated ?? false)
{
    <a class="btn btn-primary mb-3" asp-page="/Recipes/Create">+ Nueva receta</a>
}

@if (Model.Recetas == null || Model.Recetas.Count == 0)
{
    <p>No hay recetas publicadas todavía.</p>
}
else
{
    <div class="list-group">
        @foreach (var r in Model.Recetas)
        {
            string id = r.TryGetValue("id", out var idObj) ? idObj?.ToString() ?? "" : "";

            string titulo =
                (r.TryGetValue("titulo", out var t1) ? t1?.ToString() : null)
                ?? (r.TryGetValue("title", out var t2) ? t2?.ToString() : null)
                ?? "";

            string tiempo =
                (r.TryGetValue("tiempoPrep", out var tp1) ? tp1?.ToString() : null)
                ?? (r.TryGetValue("prepTimeText", out var tp2) ? tp2?.ToString() : null)
                ?? "";

            string? img =
                (r.TryGetValue("imagenUrl", out var im1) ? im1?.ToString() : null)
                ?? (r.TryGetValue("mainImageUrl", out var im2) ? im2?.ToString() : null);

            string authorUid = r.TryGetValue("authorUid", out var au) ? au?.ToString() ?? "" : "";
            bool isOwner = !string.IsNullOrWhiteSpace(authorUid) && authorUid == currentUserUid;

            string estado = r.TryGetValue("estado", out var estObj) ? estObj?.ToString() ?? "" : "";
            bool esBorrador = estado == "borrador";


            <div class="list-group-item">
                <div class="d-flex">
                    @if (!string.IsNullOrWhiteSpace(img))
                    {
                        <img src="@img" alt="@titulo"
                             class="me-3 flex-shrink-0"
                             style="width:120px;height:120px;object-fit:cover;border-radius:10px;" />
                    }

                    <div class="flex-grow-1">
                        <h5 class="mb-1">
                            @titulo
                            @if (esBorrador)
                            {
                                <span class="badge bg-secondary ms-2">Guardada (borrador)</span>
                            }
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(tiempo))
                        {
                            <div class="text-muted mb-2">⏱️ Tiempo: @tiempo</div>
                        }

                        <a class="btn btn-sm btn-success"
                           asp-page="/Recipes/Details" asp-route-id="@id">
                            Ver receta →
                        </a>

                        @if (isOwner)
                        {
                            <a class="btn btn-sm btn-primary ms-2"
                               asp-page="/Recipes/Update" asp-route-id="@id">
                                Editar
                            </a>

                            <form method="post"
                                  asp-page="/Recipes/Delete"
                                  asp-route-id="@id"
                                  data-titulo="@titulo"
                                  class="d-inline ms-2 form-eliminar-receta">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>


                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteForms = document.querySelectorAll('.form-eliminar-receta');

            deleteForms.forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault(); // Evita que se envíe directo

                    const titulo = form.getAttribute('data-titulo') || 'esta receta';

                    Swal.fire({
                        title: '¿Eliminar la receta definitivamente?',
                        text: 'Se eliminará de forma permanente: "' + titulo + '"',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit(); // Ahora sí se envía el formulario
                        }
                    });
                });
            });
        });
    </script>
}

