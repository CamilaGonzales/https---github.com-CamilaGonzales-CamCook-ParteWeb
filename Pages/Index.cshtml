@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="camcook-page-bg">
    <div class="camcook-main container py-4">

        <!-- Encabezado -->
        <div class="text-center mb-4">
            <h1 id="greeting">@Model.Saludo@(User.Identity?.IsAuthenticated ?? false ? $", {Model.NombreUsuario}" : "")</h1>
            <p class="text-muted">
                Explora las recetas de la comunidad 🍽️
            </p>
        </div>

        <!-- BUSCADOR Y BOTÓN CREAR (si está autenticado) -->
        <div class="d-flex justify-content-between align-items-center gap-2 mb-4">
            <form method="get" class="camcook-search-area flex-grow-1">
                <div class="camcook-search-input-wrapper">
                    <i class="fa fa-search camcook-search-icon"></i>
                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control camcook-search-input"
                           placeholder="Buscar recetas...">
                </div>
                <button class="btn camcook-search-btn">Buscar</button>
            </form>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a class="btn btn-success" asp-page="/Recipes/Create">
                    + Crear Receta
                </a>
            }
        </div>

        <!-- GRID DE RECETAS (todas las publicadas) -->
        <div class="row g-4">
            @foreach (var r in Model.Recetas)
            {
                <div class="col-12 col-sm-6 col-md-3">
                    <!-- Toda la tarjeta es clickeable y lleva a Details -->
                    <a class="text-decoration-none text-dark"
                       asp-page="/Recipes/Details"
                       asp-route-id="@r.Id"
                       asp-route-ids="@Model.IdsConcatenados">
                        <article class="camcook-recipe-card h-100">

                            <!-- Imagen -->
                            <div class="camcook-recipe-img-wrapper">
                                @if (!string.IsNullOrWhiteSpace(r.ImagenUrl))
                                {
                                    <img src="@r.ImagenUrl"
                                         alt="@r.Titulo"
                                         class="camcook-recipe-img" />
                                }
                                else
                                {
                                    <div class="camcook-recipe-img-placeholder">
                                        Sin imagen
                                    </div>
                                }
                            </div>

                            <div class="p-3">

                                <!-- Título -->
                                <h5 class="fw-semibold mb-2">@r.Titulo</h5>

                                <!-- Descripción corta -->
                                <p class="camcook-recipe-excerpt mb-3">
                                    @r.Descripcion
                                </p>

                                <!-- METADATOS (solo informativos) -->
                                <div class="d-flex flex-wrap gap-2 camcook-recipe-meta">
                                    @if (!string.IsNullOrWhiteSpace(r.TiempoPrep))
                                    {
                                        <span class="camcook-chip-time">
                                            ⏱️ @r.TiempoPrep
                                        </span>
                                    }

                                    @if (r.Porciones != null && r.Porciones > 0)
                                    {
                                        <span class="camcook-chip-time">
                                            🍽️ @r.Porciones porciones
                                        </span>
                                    }

                                    @if (r.Calorias != null)
                                    {
                                        <span class="camcook-chip-time">
                                            🔥 @(r.Calorias ?? 0) kcal
                                        </span>
                                    }

                                    @if (r.Likes != null)
                                    {
                                        <span class="camcook-chip-time">
                                            ❤️ @(r.Likes ?? 0)
                                        </span>
                                    }

                                    @if (r.Views != null)
                                    {
                                        <span class="camcook-chip-time">
                                            👁️ @(r.Views ?? 0)
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(r.Autor))
                                    {
                                        <span class="camcook-chip-time">
                                            👨‍🍳 @r.Autor
                                        </span>
                                    }
                                </div>

                            </div>
                        </article>
                    </a>
                </div>
            }
        </div>

        <!-- PAGINACIÓN -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación recetas" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="/Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Anterior</a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <li class="page-item active"><span class="page-link">@p</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" asp-page="/Index" asp-route-search="@Model.Search" asp-route-page="@p">@p</a></li>
                        }
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-page="/Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }

    </div>
</div>

    @section Scripts {
        <script>
            // Saludo calculado en el cliente usando la hora local del navegador
            (function () {
                try {
                    var name = @System.Text.Json.JsonSerializer.Serialize(Model.NombreUsuario ?? "");
                } catch (e) {
                    var name = "";
                }

                function computeGreeting(hour) {
                    if (hour >= 5 && hour < 12) return 'Buenos días';
                    if (hour >= 12 && hour < 18) return 'Buenas tardes';
                    return 'Buenas noches';
                }

                var now = new Date();
                var greeting = computeGreeting(now.getHours());
                var displayName = (name && name !== '""') ? JSON.parse(name) : '';

                var el = document.getElementById('greeting');
                if (el) {
                    el.textContent = greeting + (displayName ? ', ' + displayName : '');
                }
            })();
        </script>
    }
