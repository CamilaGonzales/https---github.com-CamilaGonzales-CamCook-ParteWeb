@page
@model CamCook.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registro";
}

<h2>Registro</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Input.Username" class="form-label">Nombre de usuario</label>
        <input asp-for="Input.Username" class="form-control" />
        <span asp-validation-for="Input.Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
        <input asp-for="Input.Email" class="form-control" type="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Contraseña</label>
        <input asp-for="Input.Password"
               class="form-control"
               type="password"
               minlength="8" maxlength="64"
               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9])\S{8,64}$"
               title="8–64 caracteres, incluir mayúscula, minúscula, número y símbolo, sin espacios." />
        <div class="form-text">
            Debe incluir mayúsculas, minúsculas, números y símbolos. Sin espacios.
        </div>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear cuenta</button>
</form>

<p class="mt-3">¿Ya tienes cuenta? <a asp-page="/Account/Login">Inicia sesión</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
