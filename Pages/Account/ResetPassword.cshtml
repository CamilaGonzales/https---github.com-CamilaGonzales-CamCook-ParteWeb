@page
@model CamCook.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<style>
    :root {
        --color-fondo: #FFF1CC;
        --color-acento: #E9A93A;
        --color-texto: #2A2A2A;
        --color-card: #ffffff;
        --color-borde: rgba(0,0,0,.08);
    }

    body {
        background: var(--color-fondo);
    }

    .rp-wrap {
        min-height: 72vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px 16px;
    }

    .rp-card {
        width: 100%;
        max-width: 520px;
        background: var(--color-card);
        border-radius: 18px;
        border: 1px solid var(--color-borde);
        box-shadow: 0 18px 40px rgba(0,0,0,.12);
        overflow: hidden;
    }

    .rp-header {
        padding: 22px 24px;
        background: linear-gradient(135deg, rgba(233,169,58,.22), rgba(233,169,58,.08));
        border-bottom: 1px solid var(--color-borde);
    }

    .rp-title {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: var(--color-texto);
    }

    .rp-body {
        padding: 22px 24px 24px;
    }

    .rp-label {
        font-weight: 700;
        display: block;
        margin-bottom: 6px;
    }

    .rp-input {
        width: 100%;
        height: 46px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.15);
        padding: 0 14px;
        margin-bottom: 14px;
        font-size: 15px;
    }

        .rp-input:focus {
            outline: none;
            border-color: var(--color-acento);
            box-shadow: 0 0 0 4px rgba(233,169,58,.2);
        }

    .rp-btn {
        width: 100%;
        height: 46px;
        border-radius: 12px;
        border: none;
        font-weight: 800;
        background: linear-gradient(135deg, var(--color-acento), #F6C55C);
        cursor: pointer;
    }

    .rp-msg-error {
        color: red;
        margin-bottom: 10px;
    }

    .rp-msg-ok {
        color: green;
        margin-top: 10px;
    }
</style>

<div class="rp-wrap">
    <div class="rp-card">
        <div class="rp-header">
            <h2 class="rp-title">Cambiar contraseña</h2>
        </div>

        <div class="rp-body">
            @if (!Model.TokenValid)
            {
                <p class="rp-msg-error">El enlace no es válido o ya expiró.</p>
            }
            else
            {
                <form method="post">
                    <input type="hidden" asp-for="Token" />

                    <label class="rp-label">Nueva contraseña</label>
                    <input class="rp-input" asp-for="NewPassword" type="password" required />

                    <label class="rp-label">Confirmar contraseña</label>
                    <input class="rp-input" asp-for="ConfirmPassword" type="password" required />

                    <button class="rp-btn" type="submit">Guardar contraseña</button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.Error))
                {
                    <p class="rp-msg-error">@Model.Error</p>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Success))
                {
                    <p class="rp-msg-ok">@Model.Success</p>
                    <a class="rp-link-btn" asp-page="/Account/Login">Volver al login</a>
                }
            }
        </div>
    </div>
</div>
