@page
@model CamCook.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --color-fondo: #FFF1CC; /* amarillo suave */
        --color-acento: #E9A93A; /* dorado */
        --color-texto: #2A2A2A;
        --color-card: #ffffff;
        --color-borde: rgba(0,0,0,.08);
    }

    body {
        background: var(--color-fondo);
    }

    .fp-wrap {
        min-height: 72vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px 16px;
    }

    .fp-card {
        width: 100%;
        max-width: 520px;
        background: var(--color-card);
        border: 1px solid var(--color-borde);
        border-radius: 18px;
        box-shadow: 0 18px 40px rgba(0,0,0,.12);
        overflow: hidden;
    }

    .fp-header {
        padding: 22px 24px 18px;
        background: linear-gradient(135deg, rgba(233,169,58,.22), rgba(233,169,58,.08));
        border-bottom: 1px solid var(--color-borde);
    }

    .fp-title {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: var(--color-texto);
    }

    .fp-sub {
        margin: 6px 0 0;
        color: rgba(42,42,42,.78);
        font-size: 14px;
        line-height: 1.35;
    }

    .fp-body {
        padding: 22px 24px 24px;
    }

    .fp-label {
        display: block;
        font-weight: 700;
        color: var(--color-texto);
        margin-bottom: 8px;
        font-size: 14px;
    }

    .fp-input {
        width: 100%;
        height: 48px;
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,.12);
        padding: 0 14px;
        font-size: 15px;
        outline: none;
        transition: .15s ease;
        background: #fff;
    }

        .fp-input:focus {
            border-color: rgba(233,169,58,.9);
            box-shadow: 0 0 0 4px rgba(233,169,58,.18);
        }

    .fp-actions {
        display: flex;
        gap: 10px;
        margin-top: 16px;
    }

    .fp-btn {
        height: 46px;
        border-radius: 12px;
        border: none;
        padding: 0 16px;
        font-weight: 800;
        cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease, opacity .12s ease;
    }

        .fp-btn:active {
            transform: translateY(1px);
        }

    .fp-btn-primary {
        flex: 1;
        background: linear-gradient(135deg, var(--color-acento), #F6C55C);
        color: #1f1f1f;
        box-shadow: 0 10px 22px rgba(233,169,58,.28);
    }

        .fp-btn-primary:hover {
            box-shadow: 0 14px 28px rgba(233,169,58,.33);
        }

    .fp-btn-ghost {
        background: transparent;
        border: 1px solid rgba(0,0,0,.12);
        color: rgba(42,42,42,.85);
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 120px;
    }

        .fp-btn-ghost:hover {
            opacity: .9;
        }

    .fp-foot {
        margin-top: 14px;
        font-size: 13px;
        color: rgba(42,42,42,.7);
        line-height: 1.35;
    }
</style>

<div class="fp-wrap">
    <div class="fp-card">
        <div class="fp-header">
            <h2 class="fp-title">Recuperar contraseña</h2>
            <p class="fp-sub">Escribe tu correo y te enviaremos un enlace para cambiar tu contraseña.</p>
        </div>

        <div class="fp-body">
            <form method="post">
                <label class="fp-label" for="Email">Correo</label>
                <input class="fp-input" asp-for="Email" id="Email" type="email" placeholder="ej: usuario@gmail.com" required />

                <div class="fp-actions">
                    <button class="fp-btn fp-btn-primary" type="submit">Enviar enlace</button>
                    <a class="fp-btn fp-btn-ghost" asp-page="/Account/Login">Volver</a>
                </div>

                <div class="fp-foot">
                    Revisa también <b>Spam</b>. El enlace expira en 15 minutos.
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SweetAlert básico (igual a tu imagen) -->
@if (TempData["CorreoNoEncontrado"] != null)
{
    <script>
        Swal.fire('Correo no encontrado');
    </script>
}

@if (TempData["CorreoEnviado"] != null)
{
    <script>
        Swal.fire('Revisa tu correo para cambiar tu contraseña');
    </script>
}
