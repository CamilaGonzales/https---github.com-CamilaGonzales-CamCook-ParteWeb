@page
@model CamCook.Pages.Account.LoginModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-hero py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">

                <!-- Card principal -->
                <div class="card shadow-lg border-0 rounded-4 login-card p-4 p-md-5 mb-3">
                    <div class="text-center mb-4">
                        <img src="~/img/logo3.png" alt="CamCook" width="72" class="mb-2" />
                        <h2 class="h4 mb-1 fw-bold">Bienvenido a CamCook</h2>
                        <p class="text-muted small mb-0">
                            Inicia sesión para guardar y descubrir recetas.
                        </p>
                    </div>

                    <form method="post" novalidate>
                        <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label">Usuario o correo</label>
                            <input asp-for="Username"
                                   class="form-control form-control-lg"
                                   autocomplete="username" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Password" class="form-label">Contraseña</label>

                            <div class="input-group input-group-lg">
                                <input asp-for="Password"
                                       id="Password"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password" />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        id="togglePassword"
                                        aria-label="Mostrar u ocultar contraseña">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>


                            </div>

                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end mb-3">
                            <a asp-page="/Account/ForgotPassword"
                               class="small text-decoration-none text-muted">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100 rounded-pill py-2">
                            Iniciar sesión
                        </button>
                    </form>

                    <div class="text-center mt-3 small text-muted">
                        ¿Aún no tienes cuenta?
                        <a asp-page="/Account/Register" class="text-decoration-none fw-semibold">
                            Regístrate
                        </a>
                    </div>
                </div>

                <!-- Card Google -->
                <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 text-center">
                    <p class="small text-muted mb-3">
                        O entra con tu cuenta de Google
                    </p>
                    <button id="btnGoogleLogin"
                            class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2 rounded-pill py-2">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                             alt="Google" width="20" height="20" />
                        <span>Iniciar sesión con Google</span>
                    </button>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Firebase -->
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-auth-compat.js"></script>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyAta5Bnw7MhAsvrTyQmaAfOfq1qSky51rs",
        authDomain: "imagenes-recetas-b9e6d.firebaseapp.com",
        projectId: "imagenes-recetas-b9e6d",
    };

    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const provider = new firebase.auth.GoogleAuthProvider();

    document.getElementById("btnGoogleLogin").addEventListener("click", () => {
        auth.signInWithPopup(provider)
            .then(async (result) => {
                const token = await result.user.getIdToken();
                const resp = await fetch("/Account/LoginFirebase", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ token: token })
                });
                if (resp.ok) {
                    window.location.href = "/Marketplace/Index";
                } else {
                    alert("Error en backend");
                }
            })
            .catch(err => console.error(err));
    });

    document.getElementById('togglePassword').addEventListener('click', function () {
      const input = document.getElementById('Password');
      const icon = document.getElementById('togglePasswordIcon');

      const isHidden = input.type === 'password';

      input.type = isHidden ? 'text' : 'password';

      // Si estaba oculto y ahora se muestra => ojo tachado (slash)
      icon.classList.toggle('bi-eye', !isHidden);
      icon.classList.toggle('bi-eye-slash', isHidden);
    });
</script>


</script>
